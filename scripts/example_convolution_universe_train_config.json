{
  "dataset": "SCRIPT_OVERWRITES_THIS_FROM_DATASET_DIR",
  "output_dir": "SCRIPT_OVERWRITES_THIS_OUTPUT_DIR",
  "model": {
    "name": "convolution_universe",
    "params": {
      "in_ch": 6,
      "output_dim": 1,
      "augment_shift": 3,
      "filters": 64,
      "num_layers": 9,
      "stem_kernel_size": 5,
      "stem_padding": "same",
      "block_type": "conv",
      "kernel_size": 5,
      "dilations": 1,
      "padding": "same",
      "norm": "layer",
      "norm_position": "pre",
      "pre_rnn_norm": "layer",
      "pre_rnn_activation": "gelu",
      "activation": "gelu",
      "dropout": 0.2,
      "spatial_dropout": false,
      "use_residual": true,
      "pooling": "max",
      "pool_size": 2,
      "rnn_type": "none",
      "global_pool": "avgmax",
      "global_pool_size": 1,
      "head_type": "mlp",
      "head_hidden": 64,
      "head_norm": "layer",
      "head_norm_position": "optimal",
      "head_activation": "gelu",
      "head_dropout": 0.2
    }
  },
  "batch_size": 64,
  "epochs": 250,
  "learning_rate": 0.0001,
  "lr_scheduler": {
    "name": "cosine",
    "min_lr": 1e-5
  },
  "weight_decay": 0.0,
  "gradient_clip_norm": 0.5,
  "patience": 10,
  "monitor": ["val_pearson", "val_loss"],
  "device": "auto",
  "num_workers": 0,
  "mmap_mode": "r",
  "seed": 42,
  "debug_epoch_predictions": false
}
